<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.MiniLauncher">

        <!-- 4대 컴포넌트 중 Activity 하나. LAUNCHER 카테고리가 있어야 앱 서랍에 아이콘이 생깁니다 -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- XML 화면 실습. 앱 목록에 "XML 연습" 아이콘이 따로 생깁니다 -->
        <activity
            android:name=".practice.XmlPracticeActivity"
            android:exported="true"
            android:label="XML 연습">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- XML 화면을 직접 만들어 보는 화면. 앱 목록에 "XML 연습 직접" 아이콘이 생깁니다 -->
        <activity
            android:name=".practice.MyXmlPracticeActivity"
            android:exported="true"
            android:label="XML 연습 직접">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 직접 만들어 보기의 정답. 앱 목록에 "XML 연습 정답" 아이콘이 생깁니다 -->
        <activity
            android:name=".practice.MyXmlAnswerActivity"
            android:exported="true"
            android:label="XML 연습 정답">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
