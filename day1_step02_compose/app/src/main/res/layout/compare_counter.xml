<?xml version="1.0" encoding="utf-8"?>
<!-- XML 과 Compose 비교 화면. 위쪽 절반은 XML 로, 아래쪽 절반은 Compose 로 만든 같은 카운터입니다.
     위쪽의 글자와 버튼은 이 파일에 적혀 있고, 아래쪽은 빈 자리(ComposeView)만 잡아 둡니다.
     아래쪽에 무엇을 그릴지는 XmlVsCompose.kt 의 ComposeHalf 함수에 적혀 있습니다 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- ===== 위쪽: XML 방식 ===== -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="XML 방식"
        android:textColor="#666666"
        android:textSize="16sp" />

    <!-- 숫자를 보여 주는 글자. Kotlin 코드가 xmlCount 라는 이름표로 찾아서 고칩니다 -->
    <TextView
        android:id="@+id/xmlCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0"
        android:textColor="#111111"
        android:textSize="56sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/xmlPlus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="+1" />

    <Button
        android:id="@+id/xmlValueOnly"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="값만 +1 (글자는 안 고침)" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="20dp"
        android:background="#DDDDDD" />

    <!-- ===== 아래쪽: Compose 방식. 자리만 잡아 둡니다 ===== -->
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/composeHalf"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
</LinearLayout>
