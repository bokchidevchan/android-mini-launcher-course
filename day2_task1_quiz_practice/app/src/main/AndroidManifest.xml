<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 인터넷을 쓰겠다는 표시. 문제를 인터넷에서 받아 옵니다 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.MiniLauncher">

        <!-- 과제 [1] [2] [3]: 복습 퀴즈 화면. Run 하면 이 화면이 뜹니다 -->
        <activity
            android:name=".practice.QuizActivity"
            android:exported="true"
            android:label="복습 퀴즈">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 과제 [4]: 멈추는 화면. 앱 목록에 "멈춤 고치기" 아이콘이 따로 생깁니다 -->
        <activity
            android:name=".practice.FreezeFixActivity"
            android:exported="true"
            android:label="멈춤 고치기"
            android:taskAffinity="com.example.minilauncher.freezefixactivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
