<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 위젯이 "설치 앱 N개"를 세려고 다른 앱 목록을 봅니다. 무엇을 찾을지 미리 적습니다 (아이콘이 있는 앱 전부) -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.MiniLauncher">

        <!-- 안내 화면. Run 하면 이 화면이 뜹니다 -->
        <activity
            android:name=".practice.WidgetGuideActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 홈 화면 위젯. 위젯도 방송을 받는 Receiver 라서 receiver 로 적습니다 -->
        <receiver
            android:name=".practice.MiniWidget"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/mini_widget_info" />
        </receiver>
    </application>
</manifest>
