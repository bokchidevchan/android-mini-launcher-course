<?xml version="1.0" encoding="utf-8"?>
<!-- AndroidManifest.xml 은 앱의 신고서입니다.
     "이 앱에 어떤 부품이 있고 어떤 권한을 쓰는지"를 시스템에 알립니다.
     여기에 적지 않은 Activity, Service 는 시스템이 찾지 못합니다 -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 권한. 앱이 쓰겠다고 미리 적어 두는 것 -->
    <!-- Foreground Service 를 쓰겠다 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- 그 종류는 dataSync (Android 14 부터 종류마다 따로 적음) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- 알림을 띄우겠다 (Android 13 부터. 적는 것에 더해 사용자에게 허락도 받아야 함) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 앱 전체 설정. label 은 아이콘 아래에 보이는 이름 -->
    <application
        android:allowBackup="true"
        android:label="Clean Launcher"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <!-- 화면 하나. exported="true" 는 앱 밖(시스템)에서 열 수 있다는 뜻 -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <!-- MAIN + LAUNCHER: 앱 목록에 아이콘이 생기고, 누르면 이 화면부터 열림 -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 3일차에는 여기에 HOME 카테고리를 넣어 홈 버튼에 연결합니다 -->
        </activity>

        <!-- 화면 없이 일하는 부품. exported="false" 는 이 앱 안에서만 쓴다는 뜻 -->
        <service
            android:name=".HelloService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
