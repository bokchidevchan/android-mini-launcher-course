<?xml version="1.0" encoding="utf-8"?>
<!-- AndroidManifest.xml 은 앱의 설계도입니다.
     "이 앱에 어떤 화면이 있고 어떤 권한을 쓰는지"를 시스템에 알립니다.
     여기에 적지 않은 화면은 시스템이 찾지 못합니다.
     모듈마다 하나씩 있고, 빌드할 때 하나로 합쳐집니다 (core/data 의 Manifest 도 같이 봅니다) -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 앱 전체 설정. label 은 아이콘 아래에 보이는 이름 -->
    <application
        android:allowBackup="true"
        android:label="Clean Launcher"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <!-- 화면 하나. exported="true" 는 앱 밖(시스템)에서 열 수 있다는 뜻 -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <!-- MAIN + LAUNCHER: 앱 목록에 아이콘이 생기고, 누르면 이 화면부터 열림 -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 3일차에는 여기에 HOME 카테고리를 넣어 홈 버튼에 연결합니다 -->
        </activity>
    </application>
</manifest>
