<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 고정 앱 16개의 아이콘을 읽으려면 이 앱들을 보겠다고 미리 적어야 합니다 (패키지 공개 범위, 3일차에 자세히) -->
    <queries>
        <package android:name="com.google.android.calendar" />
        <package android:name="com.android.camera2" />
        <package android:name="com.android.chrome" />
        <package android:name="com.google.android.deskclock" />
        <package android:name="com.google.android.contacts" />
        <package android:name="com.google.android.apps.docs" />
        <package android:name="com.google.android.documentsui" />
        <package android:name="com.google.android.gm" />
        <package android:name="com.google.android.googlequicksearchbox" />
        <package android:name="com.google.android.apps.maps" />
        <package android:name="com.google.android.apps.messaging" />
        <package android:name="com.google.android.dialer" />
        <package android:name="com.google.android.apps.photos" />
        <package android:name="com.android.settings" />
        <package android:name="com.google.android.youtube" />
        <package android:name="com.google.android.apps.youtube.music" />
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.MiniLauncher">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ViewModel 없는 계산기. 앱 목록에 "계산기 ViewModel 없음" 아이콘이 따로 생깁니다 -->
        <activity
            android:name=".MainActivity2"
            android:exported="true"
            android:label="계산기 ViewModel 없음"
            android:taskAffinity="com.example.minilauncher.mainactivity2">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 1일차 오후 생명주기 실습. 앱 목록에 "생명주기 연습" 아이콘이 생깁니다 -->
        <activity
            android:name=".practice.LifecyclePracticeActivity"
            android:exported="true"
            android:label="생명주기 연습"
            android:taskAffinity="com.example.minilauncher.lifecyclepracticeactivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 1일차 오후 생명주기 실습. 앱 목록에 "생명주기 연습 직접" 아이콘이 생깁니다 -->
        <activity
            android:name=".practice.MyLifecycleActivity"
            android:exported="true"
            android:label="생명주기 연습 직접"
            android:taskAffinity="com.example.minilauncher.mylifecycleactivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 생명주기 실습의 계산기 화면. 아이콘 없이 Intent 로만 엽니다 -->
        <activity
            android:name=".practice.CalculatorActivity"
            android:exported="false" />
        <activity
            android:name=".practice.MyCalculatorActivity"
            android:exported="false" />
    </application>
</manifest>
