<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Foreground Service 와 알림을 쓰겠다는 표시 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.MiniLauncher">

        <!-- 타이머 화면. Run 하면 이 화면이 뜹니다 -->
        <activity
            android:name=".practice.RamenTimerActivity"
            android:exported="true"
            android:label="컵라면 타이머">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 시간을 세는 Service. foregroundServiceType 은 Android 14 부터 꼭 적습니다 -->
        <service
            android:name=".practice.RamenTimerService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
