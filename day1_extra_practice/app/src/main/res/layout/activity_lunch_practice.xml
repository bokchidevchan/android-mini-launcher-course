<?xml version="1.0" encoding="utf-8"?>
<!-- XML 로 만드는 화면. 태그 하나가 화면 조각 하나입니다.
     LinearLayout 은 안에 든 것을 한 줄로 놓습니다 (vertical 은 세로). Compose 의 Column 자리입니다 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- 제목 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="오늘 점심 뭐 먹지?"
        android:textSize="24sp"
        android:textStyle="bold" />

    <!-- 여기부터 직접 만듭니다. 완성 화면과 요구사항은 교안의 1일차 8교시 장에 있습니다.
         day1_step01_project 의 res/layout/xml_step1~5.xml 을 참고합니다. 막히면 README.md 의 힌트를 엽니다 -->
</LinearLayout>
